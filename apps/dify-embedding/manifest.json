{
  "manifest_version": 3,
  "name": "Dify Side Panel",
  "version": "1.0",
  "permissions": ["sidePanel", "activeTab", "scripting"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Dify Side Panel"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_script.js"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' http://localhost; object-src 'self'; connect-src 'self' http://localhost"
  }
}